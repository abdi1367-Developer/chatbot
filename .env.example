############################################################
#  تنظیمات اختیاری چت‌بات
#  کپی کنید به .env.local (برای لوکال) و همین متغیرها را در
#  Vercel > Project > Settings > Environment Variables وارد کنید.
#
#  هیچ‌کدام از این متغیرها اجباری نیستند؛ چت‌بات بدون آن‌ها هم
#  کامل کار می‌کند (موتور جستجوی محلی روی داده‌های FAQ).
############################################################

# --- اختیاری: ارسال سرنخ‌ها (نام و شماره تماس) به یک وب‌هوک ---
# مثلا ERP، CRM، Google Sheet (از طریق Apps Script)، n8n، Make یا Slack
# مثال: https://hooks.slack.com/services/xxx/yyy/zzz
LEAD_WEBHOOK_URL=

# --- اختیاری: فعال‌سازی پاسخ هوشمند با مدل زبانی (LLM) ---
# به صورت پیش‌فرض خاموش است. اگر می‌خواهید پاسخ‌ها طبیعی‌تر بازنویسی شوند
# مقدار را true کنید و کلید را وارد کنید (سازگار با OpenAI و سرویس‌های مشابه).
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
